@using Microsoft.AspNetCore.Identity
@using CreditsApp.Data
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using CreditsApp.Account.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Credits</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container">
        <a class="navbar-brand" href="/">Credits</a>
        <div class="ms-auto">
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="btn btn-link me-2" href="/Account">Account</a>
                <a class="btn btn-link me-2" href="/Transactions">Transactions</a>
                <form class="d-inline" method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="~/">
                    <button class="btn btn-outline-secondary btn-sm" type="submit">Logout</button>
                </form>
            }
            else
            {
                <a class="btn btn-primary btn-sm me-2" asp-area="Identity" asp-page="/Account/Login">Login</a>
                <a class="btn btn-outline-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Sign up</a>
            }
        </div>
    </div>
</nav>
<main class="container py-4">
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</main>
</body>
</html>